# Somente desenvolvimento local. Copie para .env e defina uma senha.
POSTGRES_DB=compara_preco
POSTGRES_USER=compara_preco
POSTGRES_PASSWORD=troque-por-uma-senha-local
POSTGRES_PORT=15432

# Use true ao publicar com HTTPS.
SESSION_COOKIE_SECURE=false
# Criação administrativa inicial: habilitar apenas no terminal e fornecer credenciais por ambiente.
APP_ADMIN_HABILITADO=false
